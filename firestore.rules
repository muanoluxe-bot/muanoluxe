rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
  match /products/{id} { allow read: if resource.data.active == true || isAdmin(); allow write: if false; }
  match /settings/store { allow read: if true; allow write: if false; }
  match /orders/{id} { allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()); allow write: if false; }
  match /subscribers/{id} { allow read: if isAdmin(); allow write: if false; }
  match /notifications/{id} { allow read: if isAdmin(); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
