{
  "name": "muanoluxe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy",
    "admin:grant": "node scripts/grant-admin.mjs",
    "test:browser": "playwright test",
    "build:preview": "vite build --mode preview",
    "build:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "test:integration": "firebase emulators:exec --only firestore,storage --project demo-muanoluxe \"node --test tests/firestore.rules.test.mjs tests/storage.rules.test.mjs tests/functions.integration.mjs\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.9.9",
    "vite": "^6.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
